#!/usr/bin/env bash
# Common inference runtime overlay. Source the normal pod-runtime environment
# first, then make CUDA/workload-specific choices without changing production
# defaults in .env.

: "${POD_RUNTIME_DIR:=/workspace/pod-runtime}"
source "${POD_RUNTIME_DIR}/.env"

case "${CUDA_VARIANT:-}" in
  cu128)
    export TORCH_CUDA=cu128
    export TORCH_CHANNEL=stable
    export TORCH_STABLE_VER="${TORCH_STABLE_VER:-2.11.0}"
    export TORCH_INDEX=https://download.pytorch.org/whl/cu128
    export CUPY_VER="${CUPY_VER:-cupy-cuda12x>=13.6.0}"
    ;;
  cu130)
    export TORCH_CUDA=cu130
    export TORCH_CHANNEL=stable
    export TORCH_STABLE_VER="${TORCH_STABLE_VER:-2.11.0}"
    export TORCH_INDEX=https://download.pytorch.org/whl/cu130
    export CUPY_VER="${CUPY_VER:-cupy-cuda13x}"
    ;;
  "")
    echo "[inference] CUDA_VARIANT is unset; retaining generic pod-runtime CUDA defaults." >&2
    ;;
  *)
    echo "[inference] Unknown CUDA_VARIANT='${CUDA_VARIANT}'; retaining generic pod-runtime CUDA defaults." >&2
    ;;
esac

# Use the manifest from the exact pod-runtime revision that owns this launcher.
export CUSTOM_NODES_MANIFEST_URL_OVERRIDE="${CUSTOM_NODES_MANIFEST_URL_OVERRIDE:-${POD_RUNTIME_DIR}/custom_nodes_manifest.json}"
export CUSTOM_NODES_MANIFEST_URL="${CUSTOM_NODES_MANIFEST_URL_OVERRIDE}"

case "${COMFY_WORKLOAD:-generic}" in
  generic)
    ;;

  krea2)
    export CUSTOM_NODE_SETS="${CUSTOM_NODE_SETS:-krea2}"
    export HF_BASE_DOWNLOADS="${HF_BASE_DOWNLOADS:-krea2,rmbg}"
    export HF_LORA_DOWNLOADS="${HF_LORA_DOWNLOADS:-}"
    ;;

  minimax)
    export CUSTOM_NODE_SETS="${CUSTOM_NODE_SETS:-minimax}"
    export HF_BASE_DOWNLOADS="${HF_BASE_DOWNLOADS:-minimax}"
    export HF_LORA_DOWNLOADS="${HF_LORA_DOWNLOADS:-}"
    export ENABLE_SAGE="${ENABLE_SAGE:-true}"
    export COMFY_USE_SAGE_ATTENTION="${COMFY_USE_SAGE_ATTENTION:-false}"
    export COMFY_USE_KITCHEN_ATTENTION="${COMFY_USE_KITCHEN_ATTENTION:-false}"
    export COMFY_DISABLE_DYNAMIC_VRAM="${COMFY_DISABLE_DYNAMIC_VRAM:-true}"
    ;;

  imagedit)
    export CUSTOM_NODE_SETS="${CUSTOM_NODE_SETS:-imagedit}"
    export HF_BASE_DOWNLOADS="${HF_BASE_DOWNLOADS:-rmbg}"
    export HF_LORA_DOWNLOADS="${HF_LORA_DOWNLOADS:-}"
    ;;
esac

export ENABLE_MODEL_MANIFEST_DOWNLOAD="${ENABLE_MODEL_MANIFEST_DOWNLOAD:-true}"
export INSTALL_CUSTOM_NODES="${INSTALL_CUSTOM_NODES:-true}"
export ENABLE_CIVITAI_DOWNLOAD="${ENABLE_CIVITAI_DOWNLOAD:-false}"

printf '[inference] profile: workload=%s cuda=%s torch_cuda=%s nodes=%s models=%s\n' \
  "${COMFY_WORKLOAD:-generic}" \
  "${CUDA_VARIANT:-unknown}" \
  "${TORCH_CUDA:-unknown}" \
  "${CUSTOM_NODE_SETS:-<default>}" \
  "${HF_BASE_DOWNLOADS:-<none>}"
