#!/usr/bin/env bash
set -euo pipefail

# Resolve through /usr/local/bin/rpods (or any other symlink) so the companion
# Python entrypoint is always located relative to the real pod-runtime checkout.
script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
exec python3 "$repo_root/bin/rpods.py" "$@"
