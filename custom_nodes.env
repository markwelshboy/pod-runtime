#!/usr/bin/env bash
# Custom-node manifest selection.
# The default set is always installed; add optional comma/space-separated sets.
export CUSTOM_NODES_MANIFEST_URL="${CUSTOM_NODES_MANIFEST_URL_OVERRIDE:-https://raw.githubusercontent.com/markwelshboy/pod-runtime/main/custom_nodes_manifest.json}"
export CUSTOM_NODE_SETS="${CUSTOM_NODE_SETS:-}"

# Runtime path contract for split /opt application + /workspace persistence.
export COMFYUI_MODEL_PATH="${COMFYUI_MODEL_PATH:-${COMFY_HOME:-/workspace/ComfyUI}/models}"

# Fresh custom-node repos are intentionally shallow unless explicitly overridden.
export GIT_DEPTH="${GIT_DEPTH:-1}"

# HFF owns the central telemetry namespace. Custom-node profiling inherits it so
# manual `hff telemetry FILE` and automatic profile publication land together.
export HFF_TELEMETRY_PREFIX="${HFF_TELEMETRY_PREFIX:-telemetry/custom_nodes/v1}"
export CUSTOM_NODE_PROFILE_PUBLISH="${CUSTOM_NODE_PROFILE_PUBLISH:-1}"
export CUSTOM_NODE_PROFILE_REMOTE_PREFIX="${CUSTOM_NODE_PROFILE_REMOTE_PREFIX:-${HFF_TELEMETRY_PREFIX}}"
export CUSTOM_NODE_PROFILE_PUBLISH_TIMEOUT="${CUSTOM_NODE_PROFILE_PUBLISH_TIMEOUT:-45}"

# Quality sampling: conservative defaults. A degraded run is still uploaded but
# is excluded from the normal performance baseline by the quality-aware reporter.
export CUSTOM_NODE_QUALITY_SAMPLE_INTERVAL="${CUSTOM_NODE_QUALITY_SAMPLE_INTERVAL:-1}"
export CUSTOM_NODE_QUALITY_CPU_PSI_LIMIT="${CUSTOM_NODE_QUALITY_CPU_PSI_LIMIT:-20}"
export CUSTOM_NODE_QUALITY_IO_PSI_LIMIT="${CUSTOM_NODE_QUALITY_IO_PSI_LIMIT:-10}"
export CUSTOM_NODE_QUALITY_MEMORY_PSI_LIMIT="${CUSTOM_NODE_QUALITY_MEMORY_PSI_LIMIT:-5}"
export CUSTOM_NODE_QUALITY_CPU_THROTTLE_LIMIT="${CUSTOM_NODE_QUALITY_CPU_THROTTLE_LIMIT:-0.15}"
export CUSTOM_NODE_QUALITY_SLOW_TRANSFER_BPS="${CUSTOM_NODE_QUALITY_SLOW_TRANSFER_BPS:-5000000}"
export CUSTOM_NODE_QUALITY_LARGE_TRANSFER_BYTES="${CUSTOM_NODE_QUALITY_LARGE_TRANSFER_BYTES:-50000000}"
export CUSTOM_NODE_QUALITY_LONG_GIT_SECONDS="${CUSTOM_NODE_QUALITY_LONG_GIT_SECONDS:-60}"

# Runtime wrapper composes hardened execution, profiling, quality gating, and
# best-effort publication through hff telemetry.
_runtime_dir="${POD_RUNTIME_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
export CUSTOM_NODES_TOOL="${CUSTOM_NODES_TOOL_OVERRIDE:-${_runtime_dir}/bin/custom_nodes_runtime.py}"
export CUSTOM_NODES_PROFILE_TOOL="${CUSTOM_NODES_PROFILE_TOOL_OVERRIDE:-${_runtime_dir}/bin/custom_nodes_profile_report_quality.py}"

# Use the pack-aware resolver by default. An explicit override must use the
# dedicated *_OVERRIDE variable so re-sourcing helpers cannot retain an old
# resolver path from an earlier shell session.
export CUSTOM_NODES_WORKFLOW_TOOL="${CUSTOM_NODES_WORKFLOW_TOOL_OVERRIDE:-${_runtime_dir}/bin/custom_nodes_from_workflow_v3.py}"
unset _runtime_dir
