#!/usr/bin/env bash
# Custom-node manifest selection.
# The default set is always installed; add optional comma/space-separated sets.
export CUSTOM_NODES_MANIFEST_URL="${CUSTOM_NODES_MANIFEST_URL_OVERRIDE:-https://raw.githubusercontent.com/markwelshboy/pod-runtime/main/custom_nodes_manifest.json}"
export CUSTOM_NODE_SETS="${CUSTOM_NODE_SETS:-}"

# Custom-node profiling is retained locally and, when HF credentials/repo settings
# are available, published best-effort to the configured central Hugging Face repo.
export CUSTOM_NODE_PROFILE_PUBLISH="${CUSTOM_NODE_PROFILE_PUBLISH:-1}"
export CUSTOM_NODE_PROFILE_REMOTE_PREFIX="${CUSTOM_NODE_PROFILE_REMOTE_PREFIX:-telemetry/custom_nodes/v1}"
export CUSTOM_NODE_PROFILE_PUBLISH_TIMEOUT="${CUSTOM_NODE_PROFILE_PUBLISH_TIMEOUT:-45}"

# Telemetry wrapper keeps profiling + hardened execution and automatically publishes
# the finalized per-run JSON through hff. Publication failures never fail startup.
export CUSTOM_NODES_TOOL="${CUSTOM_NODES_TOOL_OVERRIDE:-${POD_RUNTIME_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}/bin/custom_nodes_telemetry.py}"

# Use the pack-aware resolver by default. An explicit override must use the
# dedicated *_OVERRIDE variable so re-sourcing helpers cannot retain an old
# resolver path from an earlier shell session.
export CUSTOM_NODES_WORKFLOW_TOOL="${CUSTOM_NODES_WORKFLOW_TOOL_OVERRIDE:-${POD_RUNTIME_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}/bin/custom_nodes_from_workflow_v3.py}"
