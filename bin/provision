#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
FULL_PROVISION="${SCRIPT_DIR}/provision_full"
QUALIFY_ONLY="${SCRIPT_DIR}/provision_qualify"

if [[ $# -lt 1 || "$1" != "ssh" ]]; then
    exec "$FULL_PROVISION" "$@"
fi

shift
SSH_ARGS=("$@")

# Self-provisioning images own their live pod-runtime checkout and HFF venv.
# Detect the opt-in from PID 1's container environment rather than the SSH
# session, because sshd does not normally forward arbitrary Pod env variables.
if ssh "${SSH_ARGS[@]}" \
    'tr "\0" "\n" </proc/1/environ 2>/dev/null | grep -Eq "^RENT_POD_SELF_PROVISIONING=(1|true|TRUE|yes|YES|on|ON)$"' \
    >/dev/null 2>&1
then
    echo "[provision] Self-provisioning template detected."
    echo "[provision] Image owns pod-runtime/HFF; running qualification only."
    exec "$QUALIFY_ONLY" ssh "${SSH_ARGS[@]}"
fi

exec "$FULL_PROVISION" ssh "${SSH_ARGS[@]}"
