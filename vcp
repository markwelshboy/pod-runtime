#!/usr/bin/env bash
set -euo pipefail

# Resolve the real launcher path before deriving the repository root. vcp is
# normally exposed via ~/.local/bin/vcp -> ~/git/pod-runtime/vcp.
SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f -- "$SCRIPT_PATH")"
fi
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"

HELPERS="$ROOT/helpers_shell.sh"
VCP_PY="$ROOT/bin/vcp.py"

if [[ ! -f "$HELPERS" ]]; then
  echo "[vcp] ERROR: helpers_shell.sh not found in pod-runtime root: $HELPERS" >&2
  exit 1
fi
if [[ ! -f "$VCP_PY" ]]; then
  echo "[vcp] ERROR: bin/vcp.py not found: $VCP_PY" >&2
  exit 1
fi

# Reuse hff's isolated Hugging Face environment, but do not upgrade it on
# every vcp invocation when it is already healthy.
# shellcheck disable=SC1090
source "$HELPERS"
if [[ ! -x "$HFF_VENV/bin/python" ]] || ! "$HFF_VENV/bin/python" -c 'import huggingface_hub' >/dev/null 2>&1; then
  ensure_hf_tools_venv
fi

export VCP_HFF_PY="${VCP_HFF_PY:-$ROOT/bin/hff.py}"

# vcp is intentionally a local-controller command. The pod may not expose
# platform-injected HF_TOKEN values to a non-interactive SSH shell. Inject the
# controller token into the generated remote HFF bootstrap only after the pod's
# environment/secrets and helpers_shell.sh have all been sourced. This is the
# final point before HFF checks/uses the credential, so nothing can clobber it.
# The token exists only in the encrypted SSH stdin stream for that command; it
# is not added to argv, ~/.config/vcp/config.json, or written to a pod file.
exec "$HFF_VENV/bin/python" - "$VCP_PY" "$@" <<'PY'
import importlib.util
import os
import shlex
import subprocess
import sys

module_path = sys.argv[1]
vcp_argv = sys.argv[2:]

spec = importlib.util.spec_from_file_location("vcp_impl", module_path)
if spec is None or spec.loader is None:
    raise SystemExit(f"[vcp] ERROR: could not load {module_path}")
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

_original_remote_hff_bootstrap = mod._remote_hff_bootstrap


def _remote_hff_bootstrap_with_controller_token(repo, repo_type):
    bootstrap = _original_remote_hff_bootstrap(repo, repo_type)
    token = os.environ.get("HF_TOKEN", "")
    if not token:
        return bootstrap

    marker = 'source "$_vcp_runtime/helpers_shell.sh"\n'
    if marker not in bootstrap:
        raise mod.VcpError("could not locate remote helper bootstrap marker")

    injection = (
        marker
        + "export HF_TOKEN=" + shlex.quote(token) + "\n"
        + "export HUGGINGFACE_HUB_TOKEN=\"$HF_TOKEN\"\n"
    )
    return bootstrap.replace(marker, injection, 1)


mod._remote_hff_bootstrap = _remote_hff_bootstrap_with_controller_token
sys.argv = [module_path, *vcp_argv]

try:
    mod.main()
except mod.VcpError as exc:
    mod.die(str(exc), 1)
except subprocess.CalledProcessError as exc:
    mod.die(f"command failed with exit status {exc.returncode}", exc.returncode or 1)
except KeyboardInterrupt:
    mod.die("interrupted", 130)
except Exception as exc:
    if os.environ.get("VCP_TRACEBACK") == "1":
        raise
    mod.die(str(exc), 1)
PY
