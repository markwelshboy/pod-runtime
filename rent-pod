#!/usr/bin/env bash
set -euo pipefail

# HF credential preflight is performed by rent_pod_entry.py after the selected
# template has been resolved.  That lets a local template satisfy provisioning
# with an account-side RunPod secret (for example [secrets] HF_TOKEN = "hf")
# without requiring a duplicate HF_TOKEN value in the caller's shell.

# Resolve through /usr/local/bin/rent-pod (or any other symlink) so the
# companion Python entrypoint is always located relative to the real repo.
script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
exec python3 "$repo_root/bin/rent_pod_entry.py" "$@"
