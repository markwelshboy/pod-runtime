#!/usr/bin/env bash
set -euo pipefail

needs_hf=true
for arg in "$@"; do
    case "$arg" in
        --dry-run|--no-provision|--list|--list=*) needs_hf=false ;;
    esac
done

if [[ "$needs_hf" == true && -z "${HF_TOKEN:-}" ]]; then
    echo "ERROR: HF_TOKEN is not set; refusing to rent a paid pod that provision cannot configure." >&2
    exit 2
fi

# Resolve through /usr/local/bin/rent-pod (or any other symlink) so the
# companion Python entrypoint is always located relative to the real repo.
script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
exec python3 "$repo_root/bin/rent_pod_entry.py" "$@"
